# 이 파일을 복사해 .env 를 만들고 값을 채운다:  cp .env.example .env
# .env 는 커밋되지 않는다. 키·비밀번호를 코드나 채팅에 붙여 넣지 않는다.

# ── MongoDB (필수) ───────────────────────────────────────────────
# Atlas 접속 주소. Atlas 화면의 Connect → Drivers 에서 복사한다.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# 로컬 개발은 morning_brief_dev, 서버는 morning_brief 처럼 나눠 쓰면 실제 데이터를 건드리지 않는다.
MONGODB_DB=morning_brief_dev

# ── OpenAI (요약) ────────────────────────────────────────────────
# 없으면 AI 요약 없이 시세·헤드라인만 저장한다.
OPENAI_API_KEY=
# 기본 gpt-6.1-sol. 더 싸게는 gpt-6-luna, 더 좋게는 gpt-6-astra.
OPENAI_MODEL=gpt-6.1-sol
# 생각하는 정도: none · minimal · low · medium · high (비우면 모델 기본값)
OPENAI_REASONING_EFFORT=medium

# ── 브리핑 시각 (한국 시간, crontab 형식: 분 시 일 월 요일) ──────────
# 요일은 반드시 mon-fri 처럼 영문 약어로 적는다. 숫자로 적으면 거부한다.
BRIEF_CRON=30 7 * * mon-fri

# ── 아이폰 아침 알림 (웹 푸시) ───────────────────────────────────
# `pnpm vapid:keys` 로 한 번 만들어 붙여 넣는다. 바꾸면 모든 기기가 알림을 다시 켜야 한다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 있을 때 연락할 주소. 실제 메일 주소여야 아이폰 알림이 거절되지 않는다.
VAPID_SUBJECT=mailto:you@example.com

# ── Notion (선택) ────────────────────────────────────────────────
# 채우면 앱과 함께 Notion 데이터베이스에도 브리핑을 올린다.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ── 서버 전용 ────────────────────────────────────────────────────
# 빌드된 웹 경로. 서버에서 API 가 웹 화면도 함께 서빙할 때만 쓴다. 로컬은 비워 둔다.
WEB_DIST=
